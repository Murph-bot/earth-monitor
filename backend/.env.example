# Copy to backend/.env for local dev. Never commit real .env files.
EM_ENVIRONMENT=dev
EM_LOG_LEVEL=INFO
EM_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/earth_monitor
# JSON array — pydantic-settings parses complex values as JSON, not CSV.
EM_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
