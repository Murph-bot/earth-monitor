# Copy to backend/.env for local dev. Never commit real .env files.
EM_ENVIRONMENT=dev
EM_LOG_LEVEL=INFO
EM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/earth_monitor

# ingestion worker (python -m app.ingest)
# EM_INGEST_BACKFILL_DAYS=30       first-run lookback per AOI
# EM_INGEST_OVERLAP_HOURS=48       re-search margin for late catalog items
# EM_INGEST_INTERVAL_HOURS=        set to force one cadence for all sensors
# EM_INGEST_TICK_SECONDS=60        scheduler wake-up granularity
# EM_INGEST_MIN_INTERVAL_HOURS=6   floor on per-sensor polling cadence
# EM_INGEST_ANALYZE=true           false = catalog-only sweeps (no pixel reads, no alerts)
# EM_MAX_AOI_AREA_KM2=500          cap on a single AOI's area
# JSON array — pydantic-settings parses complex values as JSON, not CSV.
EM_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# auth (prod: set EM_ENVIRONMENT=prod + a real secret; see docs/deployment.md)
# EM_JWT_SECRET=                      HS256 signing secret — required in prod
# dev_user_email has no default: uncomment for the tokenless local-dev
# fallback (ignored outside EM_ENVIRONMENT=dev regardless).
EM_DEV_USER_EMAIL=dev@earth-monitor.local
# EM_JWT_TTL_HOURS=336                token lifetime (14 days)
# EM_RATE_AUTH_PER_MINUTE=10          register + login cap per client IP
# EM_RATE_TILES_PER_MINUTE=600        tile PNG cap per client IP
